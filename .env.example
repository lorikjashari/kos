# Optional multiplayer infra overrides (copy to .env.local).
# Leave unset to use public PeerJS + EMQX + openrelay TURN defaults.

# Custom PeerServer (https://github.com/peers/peerjs-server)
# VITE_PEER_HOST=your.peerserver.example
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/
# VITE_PEER_KEY=peerjs
# VITE_PEER_SECURE=true

# JSON array of RTCIceServer objects
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example:3478","username":"u","credential":"p"}]

# Room browser MQTT
# VITE_MQTT_BROKER=wss://broker.emqx.io:8084/mqtt
# VITE_MQTT_TOPIC=kos/fps/rooms/v1
